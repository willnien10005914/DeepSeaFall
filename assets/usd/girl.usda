        def Material "brows"
        {
            token outputs:surface.connect = </Girl/Looks/brows/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Girl/Looks/brows/Color.outputs:rgb>
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:roughness = 0.7200000286102295
                float inputs:metallic = 0.0
