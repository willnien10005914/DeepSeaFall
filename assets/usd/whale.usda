#usda 1.0
(
    defaultPrim = "Whale"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "Original DeepSeaFall PBR asset. Inspired by Girl+Whale mood; not from Behance binaries."
)

def Xform "Whale" (
    kind = "component"
)
{
    def Scope "Looks"
    {
        def Material "barnacle"
        {
            token outputs:surface.connect = </Whale/Looks/barnacle/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.430, 0.460, 0.440)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:roughness = 0.82
                float inputs:metallic = 0.0
                float inputs:clearcoat = 0.0
                float inputs:clearcoatRoughness = 0.25
                float inputs:ior = 1.37
                float inputs:specular = 0.45
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }

        def Material "barnacle_core"
        {
            token outputs:surface.connect = </Whale/Looks/barnacle_core/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.120, 0.140, 0.140)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:roughness = 0.82
                float inputs:metallic = 0.0
                float inputs:clearcoat = 0.0
                float inputs:clearcoatRoughness = 0.25
                float inputs:ior = 1.37
                float inputs:specular = 0.45
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }

        def Material "eye"
        {
            token outputs:surface.connect = </Whale/Looks/eye/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.008, 0.011, 0.013)
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:roughness = 0.12
                float inputs:metallic = 0.0
                float inputs:clearcoat = 0.0
                float inputs:clearcoatRoughness = 0.25
                float inputs:ior = 1.37
                float inputs:specular = 0.45
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }

        def Material "fluke"
        {
            token outputs:surface.connect = </Whale/Looks/fluke/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Whale/Looks/fluke/Skin.outputs:rgb>
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:roughness.connect = </Whale/Looks/fluke/Roughness.outputs:g>
                float inputs:metallic = 0.0
                float inputs:clearcoat = 0.22
                float inputs:clearcoatRoughness = 0.30
                float inputs:ior = 1.37
                float inputs:specular = 0.45
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                normal3f inputs:normal.connect = </Whale/Looks/fluke/Detail.outputs:rgb>
                token outputs:surface
            }
            def Shader "UV" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Skin" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_fluke_color.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Whale/Looks/fluke/UV.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Roughness" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_fluke_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (1, 0.82, 1, 1)
                float2 inputs:st.connect = </Whale/Looks/fluke/UV.outputs:result>
                float outputs:g
            }
            def Shader "Detail" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_fluke_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (1.3, -1.3, 2, 1)
                float4 inputs:bias = (-0.65, 0.65, -1, 0)
                float2 inputs:st.connect = </Whale/Looks/fluke/UV.outputs:result>
                float3 outputs:rgb
            }
        }

        def Material "groove"
        {
            token outputs:surface.connect = </Whale/Looks/groove/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
