    {
        def Material "belly"
        {
            token outputs:surface.connect = </Whale/Looks/belly/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.920, 0.950, 0.980)
                color3f inputs:emissiveColor = (0.040, 0.050, 0.060)
                float inputs:roughness = 0.28
                float inputs:metallic = 0.06
                float inputs:clearcoat = 0.5
                float inputs:clearcoatRoughness = 0.18
                float inputs:ior = 1.4
                float inputs:specular = 0.55
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }

        def Material "eye"
        {
            token outputs:surface.connect = </Whale/Looks/eye/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.030, 0.040, 0.050)
                color3f inputs:emissiveColor = (0.010, 0.015, 0.020)
                float inputs:roughness = 0.1
