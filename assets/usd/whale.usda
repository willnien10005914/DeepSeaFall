            }
            def Shader "UV" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "Skin" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_pectoral_color.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Whale/Looks/pectoral/UV.outputs:result>
                float3 outputs:rgb
            }
            def Shader "Roughness" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_pectoral_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (1, 0.82, 1, 1)
                float2 inputs:st.connect = </Whale/Looks/pectoral/UV.outputs:result>
                float outputs:g
            }
            def Shader "Detail" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_pectoral_normal.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (1.3, -1.3, 2, 1)
                float4 inputs:bias = (-0.65, 0.65, -1, 0)
                float2 inputs:st.connect = </Whale/Looks/pectoral/UV.outputs:result>
                float3 outputs:rgb
