                float inputs:roughness = 0.45
                float inputs:metallic = 0.12
                float inputs:clearcoat = 0.4
                float inputs:clearcoatRoughness = 0.3
                float inputs:ior = 1.4
                float inputs:specular = 0.4
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                token outputs:surface
            }
        }

