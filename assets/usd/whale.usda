        }

        def Material "whale"
        {
            token outputs:surface.connect = </Whale/Looks/whale/Shader.outputs:surface>
            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Whale/Looks/whale/diffuseColorTexture.outputs:rgb>
                color3f inputs:emissiveColor = (0.000, 0.000, 0.000)
                float inputs:roughness.connect = </Whale/Looks/whale/Roughness.outputs:g>
                float inputs:metallic = 0.0
                float inputs:clearcoat = 0.22
                float inputs:clearcoatRoughness = 0.30
                float inputs:ior = 1.37
                float inputs:specular = 0.45
                float inputs:opacity = 1
                int inputs:useSpecularWorkflow = 0
                normal3f inputs:normal.connect = </Whale/Looks/whale/normalTexture.outputs:rgb>
                token outputs:surface
            }
            def Shader "UV" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
            def Shader "diffuseColorTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_color.jpg@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Whale/Looks/whale/UV.outputs:result>
                float3 outputs:rgb
            }
            def Shader "normalTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_normal.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Whale/Looks/whale/UV.outputs:result>
                float4 inputs:scale = (1.3, -1.3, 2, 1)
                float4 inputs:bias = (-0.65, 0.65, -1, 0)
                float3 outputs:rgb
            }
            def Shader "Roughness" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @textures/whale_roughness.png@
                token inputs:sourceColorSpace = "raw"
                float4 inputs:scale = (1, 0.82, 1, 1)
                float2 inputs:st.connect = </Whale/Looks/whale/UV.outputs:result>
                float outputs:g
            }
        }

