{
  "name": "deep-sea-fall",
  "version": "1.0.0",
  "private": true,
  "description": "Vertical mobile web game \u2014 girl and whale diving endlessly",
  "scripts": {
    "start": "node server/index.mjs",
    "record": "node scripts/record-demo.mjs",
    "record:long": "node scripts/record-long-demo.mjs",
